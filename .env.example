# PostgreSQL connection string used by SQLAlchemy
DATABASE_URL=postgresql+psycopg2://gps_user:gps_password@localhost:5432/gps_tracking

# JWT
JWT_SECRET_KEY=change-this-to-a-long-random-secret-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# MQTT broker (Eclipse Mosquitto)
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_TOPIC_PATTERN=vehicles/+/location

# Vehicle status thresholds
VEHICLE_MOVING_SPEED_THRESHOLD_KMH=3.0
VEHICLE_OFFLINE_AFTER_SECONDS=60
